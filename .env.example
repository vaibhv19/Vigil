# Vigil Configuration Environment Variables Template
ENV=development
LOG_LEVEL=INFO

# Database Connection URL (PostgreSQL 16)
DATABASE_URL=postgresql://vigil_user:vigil_secure_pass@localhost:5432/vigil_db

# Docker Engine named pipe/socket
# Use npipe:////./pipe/docker_engine on Windows
# Use unix:///var/run/docker.sock on Linux/macOS
DOCKER_HOST_URL=npipe:////./pipe/docker_engine

# Absolute path on the host for mounting temporary workspaces
# WARNING: Must be an absolute path and exist on the host
WORKSPACE_BASE_DIR=d:/Coding/Projects----For Resume/Vigil/temp_workspaces
